{
    "include": ["src/**/*", "tests/**/*"],
    "exclude": ["node_modules", "build"],
    "compilerOptions": {
        "module": "nodenext",
        "target": "esnext",
        "moduleResolution": "nodenext",
        "lib": ["ESNext"],
        "esModuleInterop": true,
        "declaration": true,
        "strict": true,
        "outDir": "build"
    }
}
